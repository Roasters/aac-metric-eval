# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Generated outputs (scores, CAF caches, sidecars). Keep the public layout.
results/*
!results/perturbation_pairs/
!results/cached_scores/
!results/tables/
results/perturbation_pairs/*
results/cached_scores/*
results/tables/*
!results/perturbation_pairs/.gitkeep
!results/cached_scores/.gitkeep
!results/tables/.gitkeep
figures/
*.log
spice_errors.log

# CAF-Score is tracked as a git submodule (third_party/CAF-Score) — do not ignore it.

# Datasets & model weights (never commit — see README for how to fetch)
model_outputs/
third_party/audiocaps_meta/
data/clotho/*
!data/clotho/README.md
!data/clotho/manifest.example.json
data/audiocaps/*
!data/audiocaps/README.md
!data/audiocaps/manifest.example.json
*.wav
*.pt
*.ckpt
*.bin
*.safetensors

